# ============================================================
# Polymarket BTC 5-min Scalping Bot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to source control.
# ============================================================

# -----------------------------------------------
# Authentication — L1 (order signing)
# -----------------------------------------------
# Your Polygon wallet private key (hex, with 0x prefix).
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# The wallet address that holds your USDC balance on Polygon.
# Usually the same address derived from PRIVATE_KEY.
FUNDER_ADDRESS=0xYOUR_POLYMARKET_PROXY_OR_FUNDER_ADDRESS

# CLOB order signature type:
#   0 = direct EOA wallet
#   1 = Polymarket email/Magic proxy wallet
#   2 = browser wallet proxy / Gnosis Safe
# Leave blank to use 1 when FUNDER_ADDRESS is set, otherwise 0.
SIGNATURE_TYPE=

# CLOB REST endpoint. Default is V2 staging for migration testing.
# After production cutover, set this to https://clob.polymarket.com.
POLYMARKET_CLOB_HOST=https://clob-v2.polymarket.com

# Optional V2 builder attribution code from:
# https://polymarket.com/settings?tab=builder
# Must be a bytes32 hex string when set.
POLY_BUILDER_CODE=

# -----------------------------------------------
# Authentication — L2 (CLOB API request signing)
# Derived automatically from PRIVATE_KEY on first run.
# After derivation, copy the printed values here to
# avoid re-deriving on every restart.
# -----------------------------------------------
API_KEY=
API_SECRET=
API_PASSPHRASE=

# Set to true once after migration if saved API credentials are stale.
# The bot also auto-derives fresh credentials when V2 rejects saved ones.
CLOB_FORCE_DERIVE_CREDS=false

# -----------------------------------------------
# Operational mode
# -----------------------------------------------
# Set to true to run in simulation mode (no real orders placed).
# Recommended: always start with DRY_RUN=true to validate logic.
DRY_RUN=true

# Dollar amount of USDC to risk per trade.
POSITION_SIZE_USDC=10.0

# Maximum number of markets to trade simultaneously.
MAX_CONCURRENT_MARKETS=3

# -----------------------------------------------
# Risk management
# -----------------------------------------------
# Bot suspends trading after this many consecutive stop-losses.
MAX_CONSECUTIVE_LOSSES=3

# How long (seconds) to pause after the kill switch trips.
# Default: 3600 = 1 hour.
KILL_SWITCH_PAUSE_SECONDS=3600

# -----------------------------------------------
# Logging
# -----------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
