# ============================================================
# Polymarket BTC 5-min Scalping Bot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to source control.
# ============================================================

# -----------------------------------------------
# Authentication — L1 (order signing)
# -----------------------------------------------
# Your Polygon wallet private key (hex, with 0x prefix).
PRIVATE_KEY=0xc4720955ebcf748637de7e9ac7c0ff8f48ef979afcc4ddd284516928c6eed9c6

# The wallet address that holds your USDC balance on Polygon.
# Usually the same address derived from PRIVATE_KEY.
FUNDER_ADDRESS=0x729A3a84F70189c769c018808d16Dd174a949D0A

# -----------------------------------------------
# Authentication — L2 (CLOB API request signing)
# Derived automatically from PRIVATE_KEY on first run.
# After derivation, copy the printed values here to
# avoid re-deriving on every restart.
# -----------------------------------------------
API_KEY=019dad4e-e934-7638-8360-b55b067741e6
API_SECRET=jI3QhzAlbZcEO_YeE4ZVsNG6vX77coqZ6BZ-lYEGoic=
API_PASSPHRASE=faa1a85bfbdfd2ce9ba133b4fd3278bcfef57a12f56a0d2b09cffffb04088aba

# -----------------------------------------------
# Operational mode
# -----------------------------------------------
# Set to true to run in simulation mode (no real orders placed).
# Recommended: always start with DRY_RUN=true to validate logic.
DRY_RUN=true

# Dollar amount of USDC to risk per trade.
POSITION_SIZE_USDC=10.0

# Maximum number of markets to trade simultaneously.
MAX_CONCURRENT_MARKETS=3

# -----------------------------------------------
# Risk management
# -----------------------------------------------
# Bot suspends trading after this many consecutive stop-losses.
MAX_CONSECUTIVE_LOSSES=3

# How long (seconds) to pause after the kill switch trips.
# Default: 3600 = 1 hour.
KILL_SWITCH_PAUSE_SECONDS=3600

# -----------------------------------------------
# Logging
# -----------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
